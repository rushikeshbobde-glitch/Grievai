# =====================================================================
# GrievAI: Environment Configuration Template
# =====================================================================

# Server Settings
PORT=8000
ENVIRONMENT=production

# Security & Authentication
JWT_SECRET=replace_with_a_cryptographically_secure_random_string_2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database Configuration (PostgreSQL / Supabase / Embedded SQLite fallback)
# Format for Supabase / PostgreSQL:
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
DATABASE_URL=sqlite:///./grievai.db

# Supabase Hosted Infrastructure (Optional: for direct Supabase Auth/Storage SDK)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-never-expose-to-frontend

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,https://grievai.gov

# Storage Settings
MAX_UPLOAD_SIZE_MB=15
